SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-mail-password
MAIL_FROM="Priscilla Mail <you@example.com>"

RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

NEXT_PUBLIC_MAILBOX_ADDRESS=you@example.com
NEXT_PUBLIC_MAIL_DOMAIN=example.com
NEXT_PUBLIC_AUTO_SYNC_MINUTES=3
# Optional app-only fallback login when IMAP is not configured.
WEBMAIL_LOGIN_EMAIL=you@example.com
WEBMAIL_LOGIN_PASSWORD=change-this-password
# Code required by the Reset Password form.
WEBMAIL_RESET_CODE=change-this-reset-code
# Optional legacy fallback password. Prefer WEBMAIL_LOGIN_PASSWORD.
MAILBOX_PASSWORD=
# Optional signing secret for mailbox session cookies. Use a long random value in production.
SESSION_SECRET=
# Optional encryption secret for saved provider setup in .dist/setup.json.
# Use a long random value and keep it stable across restarts.
SETUP_SECRET=

IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASS=your-mail-password
IMAP_INBOX_FOLDER=INBOX
IMAP_SENT_FOLDER=Sent
IMAP_DRAFTS_FOLDER=Drafts
IMAP_ARCHIVE_FOLDER=Archive
IMAP_JUNK_FOLDER=Junk
IMAP_TRASH_FOLDER=Trash
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Publish DNS records at your domain host using the exact values from your mail provider.
# Example placeholders:
# MX      example.com                  10 mail.example.com
# TXT     example.com                  v=spf1 include:example.com ~all
# TXT     default._domainkey.example.com v=DKIM1; k=rsa; p=PASTE_PROVIDER_PUBLIC_KEY_HERE
# TXT     _dmarc.example.com           v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com
